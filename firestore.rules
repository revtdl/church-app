rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Members collection - everyone can read, authenticated can write
    match /members/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Events collection - everyone can read, authenticated can write
    match /events/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Announcements collection - everyone can read, authenticated can write
    match /announcements/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Sermons collection - everyone can read, authenticated can write
    match /sermons/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Prayers collection - everyone can read, authenticated can write
    match /prayers/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Gallery collection - everyone can read, authenticated can write
    match /gallery/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Offerings collection - everyone can read, authenticated can write
    match /offerings/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Donations collection - for Razorpay donations
    match /donations/{document=**} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if false;
    }

    // Login tracking - for audit trail
    match /loginLogs/{document=**} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if false;
    }

    // Active users tracking
    match /activeUsers/{document=**} {
      allow read: if request.auth != null;
      allow create, update: if true;
      allow delete: if false;
    }

    // User registrations - member profiles
    match /registrations/{document=**} {
      allow read: if request.auth != null || true;  // Allow authenticated AND public reads
      allow create, update: if true;
      allow delete: if request.auth != null;  // Allow authenticated users (admin portal) to delete
    }

    // Registration audit logs - track all registration attempts
    match /registrationAuditLogs/{document=**} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if false;
    }

    // YouTube links collection - everyone can read, authenticated can write
    match /youtubeLinks/{document=**} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
